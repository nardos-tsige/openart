<div class="max-w-4xl mx-auto px-4 py-8">
    
    <!-- Header -->
    <div class="text-center mb-8 fade-in-up">
        <h1 class="text-3xl md:text-4xl font-playfair font-bold text-gray-800 mb-2">
            Edit Artwork
        </h1>
        <p class="text-gray-500">Update your artistic creation</p>
    </div>
    
    <!-- Edit Form Card -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden fade-in-up" style="animation-delay: 0.1s">
        
        <form id="editForm">
            <!-- Current Image Preview -->
            <div class="p-8 bg-gradient-to-r from-rose-pink/5 to-soft-purple/5 border-b border-gray-100">
                <label class="block text-gray-700 font-semibold mb-3">Current Image</label>
                <div class="flex justify-center">
                    <img src="{{image.imageUrl}}" 
                         alt="{{image.title}}" 
                         class="max-h-64 rounded-lg shadow-md">
                </div>
                
                <!-- Optional: Replace Image -->
                <div class="mt-4 text-center">
                    <button type="button" id="showReplaceBtn" 
                            class="text-rose-pink text-sm hover:underline">
                        Replace with new image
                    </button>
                </div>
                
                <!-- Replace Image Section (Hidden by default) -->
                <div id="replaceSection" class="hidden mt-4">
                    <div id="dropZone" 
                         class="drag-drop-zone border-2 border-dashed border-gray-300 rounded-xl p-6 text-center cursor-pointer hover:border-rose-pink transition">
                        <input type="file" id="imageInput" name="image" accept="image/*" class="hidden">
                        <div id="replacePrompt">
                            <div class="text-3xl mb-2">📸</div>
                            <p class="text-gray-600 text-sm">Click or drag to replace image</p>
                            <p class="text-gray-400 text-xs mt-1">Max 10MB (JPG, PNG, WEBP)</p>
                        </div>
                        <div id="replacePreview" class="hidden">
                            <img id="previewImg" src="" alt="Preview" class="max-h-48 mx-auto rounded-lg mb-2">
                            <p id="fileName" class="text-gray-600 text-sm"></p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Form Fields -->
            <div class="p-8">
                <!-- Title -->
                <div class="mb-5">
                    <label class="block text-gray-700 font-semibold mb-2">Title *</label>
                    <input type="text" id="title" value="{{image.title}}" required
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-pink focus:border-transparent transition">
                </div>
                
                <!-- Description -->
                <div class="mb-5">
                    <label class="block text-gray-700 font-semibold mb-2">Description / Story</label>
                    <textarea id="description" rows="4"
                              class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-pink focus:border-transparent transition">{{image.description}}</textarea>
                </div>
                
                <!-- Category -->
                <div class="mb-5">
                    <label class="block text-gray-700 font-semibold mb-2">Category</label>
                    <select id="category"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-pink focus:border-transparent transition">
                        <option value="Photography" {{#if (eq image.category "Photography")}}selected{{/if}}>📷 Photography</option>
                        <option value="Digital Art" {{#if (eq image.category "Digital Art")}}selected{{/if}}>🎨 Digital Art</option>
                        <option value="Painting" {{#if (eq image.category "Painting")}}selected{{/if}}>🖌️ Painting</option>
                        <option value="Illustration" {{#if (eq image.category "Illustration")}}selected{{/if}}>✏️ Illustration</option>
                        <option value="Sculpture" {{#if (eq image.category "Sculpture")}}selected{{/if}}>🗿 Sculpture</option>
                        <option value="Mixed Media" {{#if (eq image.category "Mixed Media")}}selected{{/if}}>🎭 Mixed Media</option>
                    </select>
                </div>
                
                <!-- Tags -->
                <div class="mb-6">
                    <label class="block text-gray-700 font-semibold mb-2">Tags</label>
                    <input type="text" id="tags" value="{{image.tagsString}}"
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-pink focus:border-transparent transition"
                           placeholder="e.g., nature, abstract, portrait">
                    <p class="text-xs text-gray-400 mt-1">Separate tags with commas</p>
                </div>
                
                <!-- Action Buttons -->
                <div class="flex gap-4">
                    <button type="submit" 
                            id="submitBtn"
                            class="flex-1 gradient-btn text-white py-3 rounded-xl font-semibold shadow-lg transition-all duration-300">
                        Save Changes 💾
                    </button>
                    <a href="/image/{{image._id}}" 
                       class="px-6 py-3 border border-gray-300 text-gray-700 rounded-xl font-semibold hover:bg-gray-50 transition">
                        Cancel
                    </a>
                </div>
                
                <!-- Message Display -->
                <div id="editMessage" class="hidden mt-4 p-3 rounded-lg"></div>
            </div>
        </form>
    </div>
    
    <!-- Danger Zone - Delete -->
    <div class="mt-6 bg-red-50 rounded-2xl p-6 border border-red-200 fade-in-up" style="animation-delay: 0.2s">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <div>
                <h3 class="font-semibold text-red-700 mb-1">⚠️ Delete this artwork</h3>
                <p class="text-red-600 text-sm">Once deleted, it cannot be recovered</p>
            </div>
            <button onclick="deleteImage()" 
                    class="px-6 py-2 bg-red-500 text-white rounded-lg font-semibold hover:bg-red-600 transition">
                Delete Permanently
            </button>
        </div>
    </div>
</div>

<script>
    const imageId = '{{image._id}}';
    const token = localStorage.getItem('token');
    
    // Replace image functionality
    let newImageFile = null;
    const showReplaceBtn = document.getElementById('showReplaceBtn');
    const replaceSection = document.getElementById('replaceSection');
    const dropZone = document.getElementById('dropZone');
    const imageInput = document.getElementById('imageInput');
    const replacePrompt = document.getElementById('replacePrompt');
    const replacePreview = document.getElementById('replacePreview');
    const previewImg = document.getElementById('previewImg');
    const fileName = document.getElementById('fileName');
    
    showReplaceBtn.addEventListener('click', () => {
        replaceSection.classList.toggle('hidden');
        if (!replaceSection.classList.contains('hidden')) {
            showReplaceBtn.textContent = 'Cancel replace';
        } else {
            showReplaceBtn.textContent = 'Replace with new image';
            newImageFile = null;
        }
    });
    
    // Click to browse
    if (dropZone) {
        dropZone.addEventListener('click', () => {
            imageInput.click();
        });
        
        // Drag & drop
        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('drag-over');
        });
        
        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('drag-over');
        });
        
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('drag-over');
            if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                handleNewImage(e.dataTransfer.files[0]);
            }
        });
    }
    
    imageInput.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) {
            handleNewImage(e.target.files[0]);
        }
    });
    
    function handleNewImage(file) {
        if (!file.type.startsWith('image/')) {
            alert('Please select an image file');
            return;
        }
        if (file.size > 10 * 1024 * 1024) {
            alert('File too large! Maximum 10MB');
            return;
        }
        
        newImageFile = file;
        
        const reader = new FileReader();
        reader.onload = (e) => {
            previewImg.src = e.target.result;
            fileName.textContent = file.name;
            replacePrompt.classList.add('hidden');
            replacePreview.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
    }
    
    // Edit form submission
    const editForm = document.getElementById('editForm');
    const submitBtn = document.getElementById('submitBtn');
    const editMessage = document.getElementById('editMessage');
    
    editForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const title = document.getElementById('title').value.trim();
        const description = document.getElementById('description').value.trim();
        const category = document.getElementById('category').value;
        const tags = document.getElementById('tags').value;
        
        if (!title) {
            showMessage('Please enter a title', 'error');
            return;
        }
        
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving... 💾';
        
        const formData = new FormData();
        formData.append('title', title);
        formData.append('description', description);
        formData.append('category', category);
        formData.append('tags', tags);
        
        if (newImageFile) {
            formData.append('image', newImageFile);
        }
        
        try {
            const response = await fetch(`/api/images/${imageId}`, {
                method: 'PUT',
                headers: {
                    'Authorization': `Bearer ${token}`
                },
                body: formData
            });
            
            const data = await response.json();
            
            if (response.ok) {
                showMessage('✅ Artwork updated successfully! Redirecting...', 'success');
                setTimeout(() => {
                    window.location.href = `/image/${imageId}`;
                }, 1500);
            } else {
                showMessage(data.message || '❌ Update failed', 'error');
                submitBtn.disabled = false;
                submitBtn.textContent = 'Save Changes 💾';
            }
        } catch (error) {
            showMessage('❌ Network error. Please try again.', 'error');
            submitBtn.disabled = false;
            submitBtn.textContent = 'Save Changes 💾';
        }
    });
    
    // Delete image function
    async function deleteImage() {
        if (confirm('⚠️ WARNING: This will permanently delete this artwork. Are you sure?')) {
            try {
                const response = await fetch(`/api/images/${imageId}`, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                
                if (response.ok) {
                    alert('✅ Artwork deleted successfully');
                    window.location.href = '/dashboard';
                } else {
                    const data = await response.json();
                    alert(data.message || 'Delete failed');
                }
            } catch (error) {
                alert('Network error. Please try again.');
            }
        }
    }
    
    function showMessage(msg, type) {
        editMessage.textContent = msg;
        editMessage.classList.remove('hidden');
        if (type === 'success') {
            editMessage.classList.add('bg-green-100', 'text-green-700', 'border', 'border-green-200');
        } else {
            editMessage.classList.add('bg-red-100', 'text-red-700', 'border', 'border-red-200');
        }
    }
</script>