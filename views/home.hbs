<!-- Hero Section -->
<section class="hero-gradient min-h-[500px] flex items-center justify-center relative overflow-hidden">
    <div class="absolute top-20 left-10 w-64 h-64 bg-rose-pink/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-80 h-80 bg-soft-purple/20 rounded-full blur-3xl"></div>
    
    <div class="max-w-4xl mx-auto text-center px-4 py-16 relative z-10">
        <div class="inline-block px-4 py-1 bg-white/50 backdrop-blur-sm rounded-full text-rose-pink text-sm font-medium mb-6 fade-in-up">
            ✨ Where art meets soul ✨
        </div>
        <h1 class="text-5xl md:text-7xl font-playfair font-bold text-gray-800 mb-6 fade-in-up">
            Discover. Share.
            <span class="bg-gradient-to-r from-rose-pink to-soft-purple bg-clip-text text-transparent">Inspire.</span>
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto fade-in-up">
            Join a community of women artists sharing their unique vision with the world
        </p>
        
        <div class="max-w-xl mx-auto mb-6 fade-in-up">
            <div class="relative">
                <input type="text" id="searchInput" 
                       placeholder="Search by title, artist, or tags..." 
                       class="w-full px-6 py-4 pl-14 rounded-full border-0 shadow-lg focus:ring-2 focus:ring-rose-pink input-focus-effect">
                <svg class="absolute left-5 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
            </div>
        </div>
        
        <div class="flex gap-4 justify-center fade-in-up">
            <a href="/register" class="px-8 py-3 gradient-btn text-white rounded-full font-semibold shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-300">
                Start Creating
            </a>
            <a href="#gallery" class="px-8 py-3 bg-white text-gray-700 rounded-full font-semibold shadow-lg hover:shadow-xl transition-all duration-300">
                Browse Gallery
            </a>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="py-12 bg-white shadow-sm">
    <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
            <div>
                <div class="text-3xl md:text-4xl font-bold text-rose-pink">1,234+</div>
                <div class="text-gray-500 mt-1">Artworks</div>
            </div>
            <div>
                <div class="text-3xl md:text-4xl font-bold text-soft-purple">456+</div>
                <div class="text-gray-500 mt-1">Artists</div>
            </div>
            <div>
                <div class="text-3xl md:text-4xl font-bold text-rose-pink">8.9K+</div>
                <div class="text-gray-500 mt-1">Likes</div>
            </div>
            <div>
                <div class="text-3xl md:text-4xl font-bold text-soft-purple">2.3K+</div>
                <div class="text-gray-500 mt-1">Community</div>
            </div>
        </div>
    </div>
</section>

<!-- Gallery Section -->
<section id="gallery" class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-playfair font-bold text-gray-800 mb-3">
                Explore Artistic Visions
            </h2>
            <p class="text-gray-500 max-w-2xl mx-auto">
                Curated collection of stunning artwork from women creators around the world
            </p>
            <div class="w-24 h-1 bg-gradient-to-r from-rose-pink to-soft-purple mx-auto mt-4 rounded-full"></div>
        </div>
        
        <!-- Filter Tabs -->
        <div class="flex flex-wrap justify-center gap-3 mb-10">
            <button onclick="filterImages('all')" class="filter-btn px-6 py-2 bg-gradient-to-r from-rose-pink to-soft-purple text-white rounded-full font-medium transition-all" data-category="all">All</button>
            <button onclick="filterImages('Photography')" class="filter-btn px-6 py-2 bg-gray-200 text-gray-700 rounded-full font-medium hover:bg-gray-300 transition" data-category="Photography">Photography</button>
            <button onclick="filterImages('Digital Art')" class="filter-btn px-6 py-2 bg-gray-200 text-gray-700 rounded-full font-medium hover:bg-gray-300 transition" data-category="Digital Art">Digital Art</button>
            <button onclick="filterImages('Painting')" class="filter-btn px-6 py-2 bg-gray-200 text-gray-700 rounded-full font-medium hover:bg-gray-300 transition" data-category="Painting">Painting</button>
            <button onclick="filterImages('Illustration')" class="filter-btn px-6 py-2 bg-gray-200 text-gray-700 rounded-full font-medium hover:bg-gray-300 transition" data-category="Illustration">Illustration</button>
        </div>
        
        <!-- Masonry Image Grid -->
        <div id="imageGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="text-center py-10 col-span-full">
                <div class="spinner mx-auto"></div>
                <p class="text-gray-500 mt-4">Loading artwork...</p>
            </div>
        </div>
        
        <!-- Load More Button -->
        <div class="text-center mt-12">
            <button id="loadMoreBtn" onclick="loadMoreImages()" class="px-8 py-3 border-2 border-rose-pink text-rose-pink rounded-full font-semibold hover:bg-rose-pink hover:text-white transition-all duration-300 hidden">
                Load More
            </button>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="bg-gradient-to-r from-rose-pink to-soft-purple py-16 mx-4 rounded-3xl mb-16">
    <div class="max-w-4xl mx-auto text-center px-4">
        <h2 class="text-3xl md:text-4xl font-playfair font-bold text-white mb-4">
            Ready to share your art?
        </h2>
        <p class="text-white/90 text-lg mb-8">
            Join thousands of women artists already showcasing their work on OpenArt
        </p>
        <a href="/register" class="inline-block px-10 py-4 bg-white text-rose-pink rounded-full font-bold shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-300">
            Get Started Free
        </a>
    </div>
</section>

<script>
    let currentCategory = 'all';
    let currentPage = 1;
    let isLoading = false;
    let hasMore = true;
    let currentSearch = '';
    
    async function filterImages(category) {
        currentCategory = category;
        currentPage = 1;
        hasMore = true;
        
        document.querySelectorAll('.filter-btn').forEach(btn => {
            if (btn.getAttribute('data-category') === category) {
                btn.classList.remove('bg-gray-200', 'text-gray-700');
                btn.classList.add('bg-gradient-to-r', 'from-rose-pink', 'to-soft-purple', 'text-white');
            } else {
                btn.classList.remove('bg-gradient-to-r', 'from-rose-pink', 'to-soft-purple', 'text-white');
                btn.classList.add('bg-gray-200', 'text-gray-700');
            }
        });
        
        document.getElementById('imageGrid').innerHTML = `
            <div class="text-center py-10 col-span-full">
                <div class="spinner mx-auto"></div>
                <p class="text-gray-500 mt-4">Loading artwork...</p>
            </div>
        `;
        document.getElementById('loadMoreBtn').classList.add('hidden');
        
        await loadImages();
    }
    
    async function loadImages() {
        if (isLoading) return;
        isLoading = true;
        
        try {
            let url = `/api/images?page=${currentPage}&limit=9`;
            if (currentCategory !== 'all') {
                url += `&category=${encodeURIComponent(currentCategory)}`;
            }
            if (currentSearch) {
                url += `&search=${encodeURIComponent(currentSearch)}`;
            }
            
            const response = await fetch(url);
            const data = await response.json();
            
            if (response.ok) {
                if (currentPage === 1) {
                    renderImages(data.images);
                } else {
                    appendImages(data.images);
                }
                
                hasMore = data.images.length === 9;
                if (hasMore) {
                    document.getElementById('loadMoreBtn').classList.remove('hidden');
                } else {
                    document.getElementById('loadMoreBtn').classList.add('hidden');
                }
            } else {
                document.getElementById('imageGrid').innerHTML = `
                    <div class="text-center py-10 col-span-full">
                        <p class="text-red-500">Failed to load images</p>
                    </div>
                `;
            }
        } catch (error) {
            console.error('Error loading images:', error);
            document.getElementById('imageGrid').innerHTML = `
                <div class="text-center py-10 col-span-full">
                    <p class="text-red-500">Network error. Please try again.</p>
                </div>
            `;
        } finally {
            isLoading = false;
        }
    }
    
    function renderImages(images) {
        if (!images || images.length === 0) {
            document.getElementById('imageGrid').innerHTML = `
                <div class="text-center py-10 col-span-full">
                    <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <p class="text-gray-500">No artwork found.</p>
                    <a href="/upload" class="inline-block mt-4 px-6 py-2 gradient-btn text-white rounded-full">Upload First Artwork</a>
                </div>
            `;
            return;
        }
        
        const grid = document.getElementById('imageGrid');
        grid.innerHTML = images.map(image => `
            <div class="group bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 cursor-pointer"
                 onclick="window.location.href='/image/${image._id}'">
                <div class="relative overflow-hidden h-56">
                    <img src="${image.imageUrl}" alt="${image.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <div class="absolute bottom-3 left-3 right-3">
                            <p class="text-white text-sm line-clamp-2">${escapeHtml(image.description || 'No description')}</p>
                        </div>
                    </div>
                    <div class="absolute top-3 left-3">
                        <span class="px-2 py-1 bg-white/90 backdrop-blur-sm rounded-lg text-xs font-medium text-gray-700">
                            ${image.category}
                        </span>
                    </div>
                </div>
                <div class="p-4">
                    <h3 class="font-bold text-gray-800 mb-1">${escapeHtml(image.title)}</h3>
                    <div class="flex items-center justify-between text-sm">
                        <div class="flex items-center gap-1 text-gray-500">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            <span>${image.views || 0}</span>
                        </div>
                        <div class="flex items-center gap-1 text-rose-pink">
                            <svg class="w-4 h-4" fill="${image.userLiked ? '#ec4899' : 'none'}" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                            </svg>
                            <span>${image.likesCount || 0}</span>
                        </div>
                    </div>
                    <div class="mt-2 text-xs text-gray-400 flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        ${escapeHtml(image.creator?.name || 'Unknown')}
                    </div>
                </div>
            </div>
        `).join('');
    }
    
    function appendImages(images) {
        const grid = document.getElementById('imageGrid');
        const newImagesHtml = images.map(image => `
            <div class="group bg-white rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 cursor-pointer"
                 onclick="window.location.href='/image/${image._id}'">
                <div class="relative overflow-hidden h-56">
                    <img src="${image.imageUrl}" alt="${image.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <div class="absolute bottom-3 left-3 right-3">
                            <p class="text-white text-sm line-clamp-2">${escapeHtml(image.description || 'No description')}</p>
                        </div>
                    </div>
                    <div class="absolute top-3 left-3">
                        <span class="px-2 py-1 bg-white/90 backdrop-blur-sm rounded-lg text-xs font-medium text-gray-700">
                            ${image.category}
                        </span>
                    </div>
                </div>
                <div class="p-4">
                    <h3 class="font-bold text-gray-800 mb-1">${escapeHtml(image.title)}</h3>
                    <div class="flex items-center justify-between text-sm">
                        <div class="flex items-center gap-1 text-gray-500">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            <span>${image.views || 0}</span>
                        </div>
                        <div class="flex items-center gap-1 text-rose-pink">
                            <svg class="w-4 h-4" fill="${image.userLiked ? '#ec4899' : 'none'}" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                            </svg>
                            <span>${image.likesCount || 0}</span>
                        </div>
                    </div>
                    <div class="mt-2 text-xs text-gray-400 flex items-center gap-1">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        ${escapeHtml(image.creator?.name || 'Unknown')}
                    </div>
                </div>
            </div>
        `).join('');
        
        grid.insertAdjacentHTML('beforeend', newImagesHtml);
    }
    
    function loadMoreImages() {
        if (!isLoading && hasMore) {
            currentPage++;
            loadImages();
        }
    }
    
    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }
    
    // Search functionality
    const searchInput = document.getElementById('searchInput');
    let searchTimeout;
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                currentSearch = this.value;
                currentPage = 1;
                hasMore = true;
                document.getElementById('imageGrid').innerHTML = `
                    <div class="text-center py-10 col-span-full">
                        <div class="spinner mx-auto"></div>
                        <p class="text-gray-500 mt-4">Searching...</p>
                    </div>
                `;
                loadImages();
            }, 500);
        });
    }
    
    // Load initial images
    loadImages();
</script>