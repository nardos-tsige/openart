<!-- Dashboard Container -->
<div class="max-w-7xl mx-auto px-4 py-8">
    
    <!-- Welcome Header -->
    <div class="bg-gradient-to-r from-rose-pink/10 to-soft-purple/10 rounded-2xl p-8 mb-8 fade-in-up">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
            <div>
                <h1 class="text-3xl font-playfair font-bold text-gray-800 mb-2">
                    Welcome back, {{user.name}}! 👋
                </h1>
                <p class="text-gray-600">Manage your artwork and profile</p>
            </div>
            <div class="mt-4 md:mt-0 flex gap-3">
                <a href="/upload" class="px-6 py-2 gradient-btn text-white rounded-full font-semibold shadow-md hover:shadow-lg transition">
                    + Upload New Art
                </a>
            </div>
        </div>
    </div>
    
    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 fade-in-up" style="animation-delay: 0.1s">

        <!-- Total Artworks Card -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-500 text-sm mb-1">Total Artworks</p>
                    <p class="text-3xl font-bold text-gray-800">{{stats.totalImages}}</p>
                </div>
                <div class="w-12 h-12 bg-rose-pink/10 rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-rose-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Total Likes Card -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-500 text-sm mb-1">Total Likes</p>
                    <p class="text-3xl font-bold text-gray-800">{{stats.totalLikes}}</p>
                </div>
                <div class="w-12 h-12 bg-rose-pink/10 rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-rose-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Total Views Card -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-500 text-sm mb-1">Total Views</p>
                    <p class="text-3xl font-bold text-gray-800">{{stats.totalViews}}</p>
                </div>
                <div class="w-12 h-12 bg-rose-pink/10 rounded-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-rose-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Tabs Navigation -->
    <div class="border-b border-gray-200 mb-6">
        <nav class="flex gap-8">
            <button onclick="showTab('myImages')" id="tabMyImagesBtn" class="py-3 px-1 font-semibold border-b-2 border-rose-pink text-rose-pink transition">
                My Artworks
            </button>
            <button onclick="showTab('profile')" id="tabProfileBtn" class="py-3 px-1 font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition">
                My Profile
            </button>
        </nav>
    </div>
    
    <!-- Tab: My Images -->
    <div id="myImagesTab" class="fade-in-up">
        {{#if images.length}}
            <div class="masonry-grid">
                {{#each images}}
                <div class="art-card group rounded-2xl overflow-hidden bg-white shadow-lg hover:shadow-2xl transition-all duration-300 " onclick="window.location.href='/image/{{this._id}}'">

                    <!-- Image Container with Overlay -->
                    <div class="relative overflow-hidden h-64">
                        <img src="{{this.imageUrl}}" 
                             alt="{{this.title}}" 
                             class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">

                        <!-- Gradient Overlay on Hover -->
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                            <div class="absolute bottom-4 left-4 right-4">
                                <p class="text-white text-sm line-clamp-2">{{this.description}}</p>
                            </div>
                        </div>

                        <!-- Category Badge -->
                        <div class="absolute top-3 left-3">
                            <span class="px-3 py-1 bg-white/90 backdrop-blur-sm rounded-full text-xs font-semibold text-gray-700 shadow-md">
                                {{this.category}}
                            </span>
                        </div>
                    </div>

                    <!-- Card Footer -->
                    <div class="p-4">
                        <!-- Title Row -->
                        <div class="flex items-start justify-between mb-3">
                            <h3 class="font-bold text-gray-800 text-lg leading-tight">{{this.title}}</h3>
                            {{!-- Like Button --}}
                            <button class="like-btn" data-id="{{this._id}}">
                                <svg class="heart-svg w-5 h-5 inline" fill="{{#if this.userLiked}}#ec4899{{else}}none{{/if}}" stroke="#ec4899" stroke-width="1.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                                </svg>
                                <span class="like-count">{{this.likesCount}}</span>
                            </button>
                        </div>

                        <!-- Stats Row -->
                        <div class="flex items-center gap-4 mb-4 text-xs text-gray-500">
                            <div class="flex items-center gap-1">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                <span>{{this.views}} views</span>
                            </div>
                            <div class="flex items-center gap-1">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                </svg>
                                <span>{{this.comments.length}} comments</span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex gap-2 pt-2 border-t border-gray-100">
                            <a href="/image/edit/{{this._id}}"
                               onclick="event.stopPropagation()" 
                               class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-blue-50 text-blue-600 rounded-xl text-sm font-medium hover:bg-blue-100 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                                Edit
                            </a>
                            <button onclick="event.stopPropagation(); deleteImage('{{this._id}}')" 
                                    class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-red-50 text-red-600 rounded-xl text-sm font-medium hover:bg-red-100 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        {{else}}
            <!-- Empty State -->
            <div class="text-center py-16 bg-white rounded-2xl">
                <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-800 mb-2">No artworks yet</h3>
                <p class="text-gray-500 mb-6">Start sharing your artistic vision with the world</p>
                <a href="/upload" class="inline-block px-6 py-3 gradient-btn text-white rounded-full font-semibold shadow-lg">
                    Upload Your First Artwork →
                </a>
            </div>
        {{/if}}
    </div>
    
    <!-- Tab: Profile Settings -->
    <div id="profileTab" class="hidden fade-in-up">
        <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-md p-8">
            <h2 class="text-2xl font-playfair font-bold text-gray-800 mb-6">Edit Profile</h2>
            
            <!-- Profile Picture -->
            <div class="text-center mb-6">
                <div class="inline-block relative">
                    <div class="w-24 h-24 bg-gradient-to-r from-rose-pink to-soft-purple rounded-full flex items-center justify-center">
                        <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                    <button class="absolute bottom-0 right-0 bg-white rounded-full p-1 shadow-md">
                        <svg class="w-5 h-5 text-rose-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </button>
                </div>
            </div>
            
            <!-- Profile Form -->
            <form id="profileForm">
                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Full Name</label>
                    <input type="text" id="profileName" value="{{user.name}}" 
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-pink">
                </div>
                
                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Email</label>
                    <input type="email" id="profileEmail" value="{{user.email}}" 
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 cursor-not-allowed" disabled>
                    <p class="text-xs text-gray-400 mt-1">Email cannot be changed</p>
                </div>
                
                <div class="mb-4">
                    <label class="block text-gray-700 font-medium mb-2">Bio</label>
                    <textarea id="profileBio" rows="4" 
                              class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-pink"
                              placeholder="Tell us about your artistic journey...">{{user.bio}}</textarea>
                </div>
                
                <div class="mb-6">
                    <label class="block text-gray-700 font-medium mb-2">Role</label>
                    <div class="inline-block px-4 py-2 bg-gray-100 rounded-full text-sm">
                        {{user.role}} {{#if (eq user.role "creator")}}🎨{{else}}👁️{{/if}}
                    </div>
                </div>
                
                <button type="submit" 
                        class="w-full gradient-btn text-white py-3 rounded-xl font-semibold shadow-lg transition">
                    Save Changes
                </button>
            </form>
            
            <!-- Danger Zone -->
            <div class="mt-8 pt-6 border-t border-gray-200">
                <h3 class="text-red-600 font-semibold mb-3">Danger Zone</h3>
                <button onclick="deleteAccount()" 
                        class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition">
                    Delete My Account
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function initLikeButtons() {
        document.querySelectorAll('.like-btn').forEach(btn => {
            // Remove existing listener to avoid duplicates
            btn.removeEventListener('click', handleLikeClick);
            btn.addEventListener('click', handleLikeClick);
        });
    }
    
    async function handleLikeClick(e) {
        e.stopPropagation();
        
        const btn = this;
        const imageId = btn.getAttribute('data-id');
        const svg = btn.querySelector('.heart-svg');
        const countSpan = btn.querySelector('.like-count');
        const token = localStorage.getItem('token');
        
        if (!token) {
            alert('Please login to like');
            window.location.href = '/login';
            return;
        }
        
        // Store current state for rollback
        const wasLiked = svg.getAttribute('fill') === '#ec4899';
        const currentCount = parseInt(countSpan.innerText);
        
        // Optimistic update
        if (wasLiked) {
            svg.setAttribute('fill', 'none');
            countSpan.innerText = currentCount - 1;
        } else {
            svg.setAttribute('fill', '#ec4899');
            countSpan.innerText = currentCount + 1;
        }
        
        try {
            const response = await fetch(`/api/images/${imageId}/like`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });
            
            const data = await response.json();
            
            if (response.ok) {
                // Sync with server
                countSpan.innerText = data.likes;
                if (data.liked) {
                    svg.setAttribute('fill', '#ec4899');
                } else {
                    svg.setAttribute('fill', 'none');
                }
            } else {
                // Rollback on error
                if (wasLiked) {
                    svg.setAttribute('fill', '#ec4899');
                    countSpan.innerText = currentCount;
                } else {
                    svg.setAttribute('fill', 'none');
                    countSpan.innerText = currentCount;
                }
                alert(data.message || 'Failed to like');
            }
        } catch (error) {
            // Rollback on network error
            if (wasLiked) {
                svg.setAttribute('fill', '#ec4899');
                countSpan.innerText = currentCount;
            } else {
                svg.setAttribute('fill', 'none');
                countSpan.innerText = currentCount;
            }
            alert('Network error. Please try again.');
        }
    }
    
    document.addEventListener('DOMContentLoaded', initLikeButtons);

</script>

<script>
    // Tab switching
    function showTab(tab) {
        const myImagesTab = document.getElementById('myImagesTab');
        const profileTab = document.getElementById('profileTab');
        const myImagesBtn = document.getElementById('tabMyImagesBtn');
        const profileBtn = document.getElementById('tabProfileBtn');
        
        if (tab === 'myImages') {
            myImagesTab.classList.remove('hidden');
            profileTab.classList.add('hidden');
            myImagesBtn.classList.add('border-rose-pink', 'text-rose-pink');
            myImagesBtn.classList.remove('border-transparent', 'text-gray-500');
            profileBtn.classList.remove('border-rose-pink', 'text-rose-pink');
            profileBtn.classList.add('border-transparent', 'text-gray-500');
        } else {
            myImagesTab.classList.add('hidden');
            profileTab.classList.remove('hidden');
            profileBtn.classList.add('border-rose-pink', 'text-rose-pink');
            profileBtn.classList.remove('border-transparent', 'text-gray-500');
            myImagesBtn.classList.remove('border-rose-pink', 'text-rose-pink');
            myImagesBtn.classList.add('border-transparent', 'text-gray-500');
        }
    }


    // Track pending requests to prevent double toggles
    let pendingLikes = new Set();

    async function toggleLike(imageId, buttonElement) {
        const token = localStorage.getItem('token');

        if (!token) {
            alert('Please login to like');
            window.location.href = '/login';
            return;
        }

        // Prevent duplicate clicks on the same image
        if (pendingLikes.has(imageId)) {
            console.log('Already processing like for this image');
            return;
        }

        pendingLikes.add(imageId);

        const svg = buttonElement.querySelector('svg');
        const likeCountSpan = buttonElement.parentElement.querySelector('.like-count');
        const currentCount = parseInt(likeCountSpan.innerText);
        const isCurrentlyLiked = svg.getAttribute('fill') === '#ec4899';

        // Store original state for rollback
        const originalFill = svg.getAttribute('fill');
        const originalCount = currentCount;

        // Optimistic update
        if (isCurrentlyLiked) {
            svg.setAttribute('fill', 'none');
            likeCountSpan.innerText = currentCount - 1;
        } else {
            svg.setAttribute('fill', '#ec4899');
            likeCountSpan.innerText = currentCount + 1;
        }

        try {
            const response = await fetch(`/api/images/${imageId}/like`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (response.ok) {
                // Sync with server response
                likeCountSpan.innerText = data.likes;
                if (data.liked) {
                    svg.setAttribute('fill', '#ec4899');
                } else {
                    svg.setAttribute('fill', 'none');
                }
            } else {
                // Rollback on error
                svg.setAttribute('fill', originalFill);
                likeCountSpan.innerText = originalCount;
                console.error('Like failed:', data.message);
            }
        } catch (error) {
            // Rollback on network error
            svg.setAttribute('fill', originalFill);
            likeCountSpan.innerText = originalCount;
            console.error('Network error:', error);
        } finally {
            pendingLikes.delete(imageId);
        }
    }

    // Delete image
    async function deleteImage(imageId) {
        if (confirm('Are you sure you want to delete this artwork? This action cannot be undone.')) {
            const token = localStorage.getItem('token');
            
            try {
                console.log("yo")
                const response = await fetch(`/api/images/${imageId}`, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                
                if (response.ok) {
                    alert('✅ Image deleted successfully!');
                    location.reload();
                } else {
                    const data = await response.json();
                    alert('❌ ' + (data.message || 'Delete failed'));
                }
            } catch (error) {
                alert('❌ Network error. Please try again.');
            }
        }
    }
    
    // Update profile
    const profileForm = document.getElementById('profileForm');
    if (profileForm) {
        profileForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const name = document.getElementById('profileName').value;
            const bio = document.getElementById('profileBio').value;
            const token = localStorage.getItem('token');
            
            try {
                const response = await fetch('/api/users/profile', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ name, bio })
                });
                
                const data = await response.json();
                
                if (response.ok) {
                    alert('✅ Profile updated successfully!');
                    location.reload();
                } else {
                    alert('❌ ' + (data.message || 'Update failed'));
                }
            } catch (error) {
                alert('❌ Network error. Please try again.');
            }
        });
    }
    
    // Delete account
    async function deleteAccount() {
        if (confirm('⚠️ WARNING: This will permanently delete ALL your artworks and account data. Are you absolutely sure?')) {
            const token = localStorage.getItem('token');
            
            try {
                const response = await fetch('/api/users/account', {
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                
                if (response.ok) {
                    localStorage.removeItem('token');
                    alert('Account deleted. Redirecting to home...');
                    window.location.href = '/';
                } else {
                    const data = await response.json();
                    alert('❌ ' + (data.message || 'Delete failed'));
                }
            } catch (error) {
                alert('❌ Network error. Please try again.');
            }
        }
    }
</script>